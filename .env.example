# 환경변수 예시 파일 — 실제 값은 .env(레포에 커밋 금지)에 채워 넣을 것
# Example environment variables — fill actual values into a local .env (never commit it)
#
# 모의투자/실거래를 구분해서 띄우고 싶다면 이 파일 대신 .env.mock.example / .env.live.example을
# 각각 .env.mock / .env.live로 복사해 사용할 것 (Kiwoom 앱키·URL이 모드별로 달라야 하기 때문).
# 아래는 두 모드에 공통 적용되는 단일 기본 설정 예시(기본값 MOCK).
#
# To launch MOCK and LIVE as separate configs, copy .env.mock.example / .env.live.example to
# .env.mock / .env.live instead of this file (Kiwoom app key and base URL must differ per mode).
# This file remains a single default config example (defaults to MOCK).

# --- Database (PC에 이미 설치된 MySQL 사용 — Uses the MySQL instance already on this PC) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=JDWORKS
DB_USER=jdwadmin
DB_PASSWORD=!jdwadmin

# --- Trading mode: MOCK(모의투자) | LIVE(실거래) ---
TRADING_MODE=MOCK

# --- Kiwoom REST API (모드별로 별도 발급된 값을 사용) ---
KIWOOM_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# --- Risk limits ---
DAILY_LOSS_LIMIT_RATE=0.03
MAX_POSITION_RATIO_PER_STOCK=0.1
MIN_CASH_RATIO=0.2
# 과다매매 방지 (증권사 수수료 부담 완화) — Overtrading prevention (curbs brokerage fee drag)
COOLDOWN_TRADING_DAYS=3
MAX_DAILY_TRADES=5
# 자동 유니버스 크기 (코스피+코스닥 거래대금 상위 합산 상위 N종목) — Auto universe size
UNIVERSE_AUTO_SELECT_SIZE=20

# --- Mock trading seed capital (MOCK 모드 현금 잔고 산정 기준값, LIVE에는 사용 안 함) ---
MOCK_INITIAL_CAPITAL=10000000

# --- AI prediction service ---
PREDICTION_SERVICE_URL=http://localhost:8001
