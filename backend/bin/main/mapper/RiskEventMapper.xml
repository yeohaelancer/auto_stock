<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jdwork.autotrading.risk.mapper.RiskEventMapper">

    <insert id="insert" parameterType="com.jdwork.autotrading.risk.domain.RiskEvent"
            useGeneratedKeys="true" keyProperty="riskLogId" keyColumn="risk_log_id">
        INSERT INTO trading_risk_log (event_type, occurred_at, account_id, trading_mode, action_taken)
        VALUES (#{eventType}, #{occurredAt}, #{accountId}, #{tradingMode}, #{actionTaken})
    </insert>

    <!-- RiskEvent에 setter가 없어(불변에 가까운 설계) 생성자 매핑으로 복원한다 -->
    <!-- RiskEvent has no setters (near-immutable by design), so results are restored via constructor mapping -->
    <resultMap id="riskEventResultMap" type="com.jdwork.autotrading.risk.domain.RiskEvent">
        <constructor>
            <idArg column="risk_log_id" javaType="java.lang.Long"/>
            <arg column="event_type" javaType="com.jdwork.autotrading.risk.domain.RiskEvent$EventType"/>
            <arg column="occurred_at" javaType="java.time.OffsetDateTime"/>
            <arg column="account_id" javaType="java.lang.String"/>
            <arg column="trading_mode" javaType="java.lang.String"/>
            <arg column="action_taken" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="findRecentByMode" resultMap="riskEventResultMap">
        SELECT risk_log_id, event_type, occurred_at, account_id, trading_mode, action_taken
        FROM trading_risk_log
        WHERE trading_mode = #{tradingMode}
          AND deleted_at IS NULL
        ORDER BY occurred_at DESC
        LIMIT #{limit}
    </select>

</mapper>
