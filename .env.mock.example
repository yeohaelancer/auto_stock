# 모의투자(MOCK) 모드용 환경변수 예시 — 실제 값은 .env.mock(레포에 커밋 금지)에 채워 넣을 것
# Example environment variables for MOCK (paper trading) mode — fill actual values into .env.mock (never commit it)
#
# 사용법 (Usage):
#   cp .env.mock.example .env.mock   # 값 채운 뒤
#   docker-compose --env-file .env.mock up
#   또는 scripts/run-mock.sh (Windows: scripts/run-mock.bat) 로 로컬 gradlew 실행
#   Or run scripts/run-mock.sh (Windows: scripts/run-mock.bat) to launch locally via gradlew

# --- Database (PC에 이미 설치된 MySQL 사용 — Uses the MySQL instance already on this PC) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=JDWORKS
DB_USER=jdwadmin
DB_PASSWORD=!jdwadmin

# --- Trading mode ---
TRADING_MODE=MOCK

# --- Kiwoom REST API (모의투자 전용 앱키/시크릿 — 실전과 반드시 다른 값) ---
# Kiwoom REST API (MOCK-only app key/secret — must differ from the LIVE ones)
KIWOOM_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# --- Risk limits ---
DAILY_LOSS_LIMIT_RATE=0.03
MAX_POSITION_RATIO_PER_STOCK=0.1
MIN_CASH_RATIO=0.2
COOLDOWN_TRADING_DAYS=3
MAX_DAILY_TRADES=5
UNIVERSE_AUTO_SELECT_SIZE=20
# 종목별 반복 호출(일별주가 등)의 초당 요청 한도 — 미설정 시 기본 4, 실측상 429가 잦아 1~2 권장
# Per-second cap for repeated per-stock calls (e.g. daily price) — defaults to 4 if unset; 1-2 recommended, observed frequent 429s otherwise
KIWOOM_RATE_LIMIT_PER_SECOND=1

# --- Mock trading seed capital (MOCK 모드 현금 잔고 산정 기준값, LIVE에는 사용 안 함) ---
MOCK_INITIAL_CAPITAL=10000000

# --- AI prediction service ---
PREDICTION_SERVICE_URL=http://localhost:8001
