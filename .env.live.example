# 실거래(LIVE) 모드용 환경변수 예시 — 실제 값은 .env.live(레포에 커밋 금지)에 채워 넣을 것
# Example environment variables for LIVE (real) trading mode — fill actual values into .env.live (never commit it)
#
# ⚠️ 실전 계좌로 실제 주문이 나간다. 반드시 KIWOOM_APP_KEY/APP_SECRET/ACCOUNT_NO를 실전용으로
#    별도 발급받은 값으로 채울 것 — MOCK 값을 재사용하지 말 것.
# ⚠️ Real orders are placed against a real account. Always fill KIWOOM_APP_KEY/APP_SECRET/ACCOUNT_NO
#    with credentials issued specifically for LIVE — never reuse the MOCK ones.
#
# 사용법 (Usage):
#   cp .env.live.example .env.live   # 값 채운 뒤
#   docker-compose --env-file .env.live up
#   또는 scripts/run-live.sh (Windows: scripts/run-live.bat) 로 로컬 gradlew 실행
#   Or run scripts/run-live.sh (Windows: scripts/run-live.bat) to launch locally via gradlew

# --- Database (PC에 이미 설치된 MySQL 사용 — Uses the MySQL instance already on this PC) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=JDWORKS
DB_USER=jdwadmin
DB_PASSWORD=!jdwadmin

# --- Trading mode ---
TRADING_MODE=LIVE

# --- Kiwoom REST API (실전 전용 앱키/시크릿 — 모의투자와 반드시 다른 값) ---
# Kiwoom REST API (LIVE-only app key/secret — must differ from the MOCK ones)
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# --- Risk limits (실전은 더 보수적으로 조정 권장 — consider tightening these for LIVE) ---
DAILY_LOSS_LIMIT_RATE=0.03
MAX_POSITION_RATIO_PER_STOCK=0.1
MIN_CASH_RATIO=0.2
COOLDOWN_TRADING_DAYS=3
MAX_DAILY_TRADES=5
UNIVERSE_AUTO_SELECT_SIZE=20
# 종목별 반복 호출(일별주가 등)의 초당 요청 한도 — 미설정 시 기본 4로 떨어져 429가 남 (모의투자에서 실측).
# 실전 API의 실제 한도는 아직 별도로 확인 안 됨 — 모의투자와 동일하게 보수적으로 1로 시작.
# Per-second cap for repeated per-stock calls (e.g. daily price) — defaults to 4 and causes 429s if unset
# (observed on the mock API). The real LIVE API's actual limit hasn't been separately verified yet —
# starting conservatively at 1, same as MOCK.
KIWOOM_RATE_LIMIT_PER_SECOND=1

# --- Mock trading seed capital — LIVE 모드에서는 사용되지 않음 (참고용으로만 남김) ---
# Not used in LIVE mode (kept only for reference/parity with .env.mock.example)
MOCK_INITIAL_CAPITAL=10000000

# --- AI prediction service ---
PREDICTION_SERVICE_URL=http://localhost:8001
